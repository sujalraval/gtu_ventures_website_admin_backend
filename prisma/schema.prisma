generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  EDITOR
  CONTRIBUTOR
  VIEWER
}

model User {
  id            Int         @id @default(autoincrement())
  email         String      @unique
  password_hash String
  role          Role        @default(VIEWER)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  auditLogs     AuditLog[]
}

model Media {
  id           Int      @id @default(autoincrement())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  altText      String?
  refCount     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Setting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?  
  before    String?
  after     String?
  createdAt DateTime @default(now())
}

model Startup {
  id            Int      @id @default(autoincrement())
  name          String
  logoEmoji     String?
  logoPath      String?
  sector        String?
  stage         String?
  ecosystem     String?
  registered    String?
  email         String?
  phone         String?
  website       String?
  businessModel String?
  problem       String?
  market        String?
  revenueModel  String?
  technology    String?
  traction      String?
  awards        String?
  press         String?
  
  funding       Json?    // { status, amount, investors, rounds, grants, logoPath }
  regulatory    Json?    // { dpiit, startupIndia, iso, gst, patents }
  team          Json?    // Array of { name, role }
  mentors       String?
  
  publishState  String   @default("PUBLISHED") // DRAFT, REVIEW, PUBLISHED, ARCHIVED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Mentor {
  id           Int      @id @default(autoincrement())
  name         String
  initials     String?
  photo        String?
  designation  String?
  org          String?
  industry     String?
  years        String?
  mtype        Json?    // Array of strings
  bio          String?
  expertise    Json?    // Array of strings
  support      Json?    // Array of strings
  engagement   String?
  mode         String?
  sectors      String?
  languages    String?
  achievements Json?    // Array of Arrays [["number", "text"]]
  linkedin     String?
  website      String?
  email        String?
  
  publishState String   @default("PUBLISHED") // DRAFT, REVIEW, PUBLISHED, ARCHIVED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum PartnerType {
  CORPORATE
  ECOSYSTEM
  ACADEMIC
  INVESTOR
}

model Partner {
  id           Int          @id @default(autoincrement())
  name         String
  emoji        String?
  link         String?
  category     String?
  about        String?
  mou          Json?        // { status, scope, since }
  type         PartnerType  @default(CORPORATE)
  
  publishState String       @default("PUBLISHED") // DRAFT, REVIEW, PUBLISHED, ARCHIVED
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}
