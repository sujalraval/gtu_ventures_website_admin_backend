generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  EDITOR
  CONTRIBUTOR
  VIEWER
}

model User {
  id            Int        @id @default(autoincrement())
  email         String     @unique
  password_hash String
  role          Role       @default(VIEWER)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  auditLogs     AuditLog[]
}

model Media {
  id           Int      @id @default(autoincrement())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  altText      String?
  refCount     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Setting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  before    String?
  after     String?
  createdAt DateTime @default(now())
}

model Startup {
  id            Int     @id @default(autoincrement())
  name          String
  logoEmoji     String?
  logoPath      String?
  sector        String?
  stage         String?
  ecosystem     String?
  registered    String?
  email         String?
  phone         String?
  website       String?
  businessModel String?
  problem       String?
  market        String?
  revenueModel  String?
  technology    String?
  traction      String?
  awards        String?
  press         String?

  funding    Json? // { status, amount, investors, rounds, grants, logoPath }
  regulatory Json? // { dpiit, startupIndia, iso, gst, patents }
  team       Json? // Array of { name, role }
  mentors    String?

  publishState String   @default("PUBLISHED") // DRAFT, REVIEW, PUBLISHED, ARCHIVED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Mentor {
  id           Int     @id @default(autoincrement())
  name         String
  initials     String?
  photo        String?
  designation  String?
  org          String?
  industry     String?
  years        String?
  mtype        Json? // Array of strings
  bio          String?
  expertise    Json? // Array of strings
  support      Json? // Array of strings
  engagement   String?
  mode         String?
  sectors      String?
  languages    String?
  achievements Json? // Array of Arrays [["number", "text"]]
  linkedin     String?
  website      String?
  email        String?

  publishState String   @default("PUBLISHED") // DRAFT, REVIEW, PUBLISHED, ARCHIVED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum PartnerType {
  CORPORATE
  ECOSYSTEM
  ACADEMIC
  INVESTOR
}

model Partner {
  id       Int         @id @default(autoincrement())
  name     String
  emoji    String?
  link     String?
  category String?
  about    String?
  mou      Json? // { status, scope, since }
  type     PartnerType @default(CORPORATE)

  publishState String   @default("PUBLISHED") // DRAFT, REVIEW, PUBLISHED, ARCHIVED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Mou {
  id           Int      @id @default(autoincrement())
  org          String
  emoji        String?
  logo         String?
  link         String?
  status       String?
  number       String?
  title        String?
  date         String?
  effective    String?
  expiry       String?
  scope        Json?
  benefits     Json?
  activities   Json?
  brief        String?
  objective    String?
  pdf          String?
  press        String?
  publishState String   @default("PUBLISHED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Scheme {
  id            Int      @id @default(autoincrement())
  name          String
  code          String?
  desc          String?
  objectives    String?
  eligibility   String?
  beneficiaries Json?
  providedBy    String?
  authority     String?
  type          String?
  installments  String?
  departments   Json?
  category      Json?
  sectors       Json?
  budget        String?
  maxGrant      String?
  fundingType   String?
  duration      String?
  equityPct     String?
  apply         String?
  publishState  String   @default("PUBLISHED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Vertical {
  id           Int      @id @default(autoincrement())
  vid          String?
  code         String?
  name         String
  logoPath     String?
  backer       String?
  emoji        String?
  about        String?
  offerings    Json?
  forWho       String?
  publishState String   @default("PUBLISHED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Lab {
  id           Int      @id @default(autoincrement())
  name         String
  type         String?
  location     String?
  equipment    Json?
  availability String?
  bookingLink  String?
  images       Json?
  publishState String   @default("PUBLISHED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Announcement {
  id           Int      @id @default(autoincrement())
  title        String
  date         String?
  category     String?
  content      String?
  link         String?
  image        String?
  publishState String   @default("PUBLISHED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Story {
  id           Int      @id @default(autoincrement())
  startupName  String
  founder      String?
  challenge    String?
  solution     String?
  impact       Json?
  quote        String?
  coverImage   String?
  publishState String   @default("PUBLISHED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Testimonial {
  id           Int      @id @default(autoincrement())
  authorName   String
  designation  String?
  organization String?
  quote        String?
  photo        String?
  rating       Int?
  publishState String   @default("PUBLISHED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Org {
  id           Int      @id @default(autoincrement())
  name         String
  type         String?
  logo         String?
  website      String?
  description  String?
  contact      Json?
  publishState String   @default("PUBLISHED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Event {
  id           Int      @id @default(autoincrement())
  title        String
  date         String?
  location     String?
  description  String?
  image        String?
  link         String?
  status       String?
  publishState String   @default("PUBLISHED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TeamMember {
  id           Int      @id @default(autoincrement())
  name         String
  designation  String?
  photo        String?
  bio          String?
  linkedin     String?
  order        Int      @default(0)
  publishState String   @default("PUBLISHED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Resource {
  id           Int      @id @default(autoincrement())
  title        String
  type         String?
  url          String?
  description  String?
  publishState String   @default("PUBLISHED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Lead {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  phone       String?
  inquiryType String?
  message     String?
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
